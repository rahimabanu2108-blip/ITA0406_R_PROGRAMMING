# Factors of a Number
n <- 12
cat("Factors of", n, "are:\n")
for(i in 1:n)
{
  if(n %% i == 0)
    print(i)
}

# Generate 10 Random Integers
cat("\n10 Random Integers:\n")
random_numbers <- sample(-50:50, 10)
print(random_numbers)

# FizzBuzz Program
cat("\nFizzBuzz Output:\n")
for(i in 1:100)
{
  if(i %% 15 == 0)
    print("FizzBuzz")
  else if(i %% 3 == 0)
    print("Fizz")
  else if(i %% 5 == 0)
    print("Buzz")
  else
    print(i)
}
